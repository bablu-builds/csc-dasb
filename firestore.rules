rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function userDoc() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function getRole() {
      return exists(userDoc())
        ? get(userDoc()).data.role
        : null;
    }

    function isOwner() {
      return isAuth() && getRole() == 'owner';
    }

    function isManager() {
      return isAuth() && getRole() == 'manager';
    }

    function isStaff() {
      return isAuth() && getRole() == 'staff';
    }

    function isOwnerOrManager() {
      return isOwner() || isManager();
    }

    function isAnyRole() {
      return isOwner() || isManager() || isStaff();
    }

    function canAccessFinancial() {
      return isOwner()
        || isManager()
        || (isStaff() && get(userDoc()).data.canAccessFinancialServices == true);
    }

    match /workEntries/{entryId} {
      allow read, write: if isAnyRole();
    }

    match /workAdjustments/{adjId} {
      allow read, write: if isAnyRole();
    }

    function canManageCategories() {
      return isOwner()
        || isManager()
        || (isStaff() && get(userDoc()).data.canManageCategories == true);
    }

    match /categories/{catId} {
      allow read: if isAnyRole();
      allow write: if canManageCategories();
    }

    match /settings/{docId} {
      allow read: if isAnyRole();
      allow write: if isOwner();
    }

    match /users/{uid} {
      allow read: if isAuth() && request.auth.uid == uid;
      allow read: if isOwner();
      allow create: if isAuth() && request.auth.uid == uid
                    && request.resource.data.role in ['owner', 'manager', 'staff'];
      allow create: if isOwner();
      allow update, delete: if isOwner();
      allow update: if isAuth() && request.auth.uid == uid
                    && request.resource.data.role == resource.data.role;
    }

    match /pendingInvites/{inviteId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /aepsWithdrawals/{id} {
      allow read, write: if canAccessFinancial();
    }

    match /electricRecharges/{id} {
      allow read, write: if canAccessFinancial();
    }

    match /moneyTransfers/{id} {
      allow read, write: if canAccessFinancial();
    }

    match /flightBookings/{id} {
      allow read, write: if canAccessFinancial();
    }

    match /quickActionWork/{id} {
      allow read, write: if isAnyRole();
    }

    match /paymentHistory/{id} {
      allow read, write: if isAnyRole();
    }
  }
}