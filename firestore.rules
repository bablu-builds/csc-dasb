rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ─────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function userDoc() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function getRole() {
      return exists(userDoc())
        ? get(userDoc()).data.role
        : null;
    }

    function isOwner() {
      return isAuth() && getRole() == 'owner';
    }

    function isStaff() {
      return isAuth() && getRole() == 'staff';
    }

    function isOwnerOrStaff() {
      return isOwner() || isStaff();
    }

    // Staff with explicit financial-services permission, or the owner
    function canAccessFinancial() {
      return isOwner() || (isStaff() && get(userDoc()).data.canAccessFinancialServices == true);
    }

    // ── workEntries — both roles can read and write ───────────────────────────
    match /workEntries/{entryId} {
      allow read, write: if isOwnerOrStaff();
    }

    // ── categories — both roles can read; owner manages ──────────────────────
    match /categories/{catId} {
      allow read: if isOwnerOrStaff();
      allow write: if isOwner();
    }

    // ── settings — both roles can read; owner can write ──────────────────────
    match /settings/{docId} {
      allow read: if isOwnerOrStaff();
      allow write: if isOwner();
    }

    // ── users — role-based access ─────────────────────────────────────────────
    match /users/{uid} {
      // Anyone authenticated can read their own profile
      allow read: if isAuth() && request.auth.uid == uid;
      // Owner can read all profiles (for Staff Management)
      allow read: if isOwner();
      // A user can create their own profile (owner bootstrap or email-link first sign-in)
      allow create: if isAuth() && request.auth.uid == uid
                    && request.resource.data.role in ['owner', 'staff'];
      // Only owner can update/delete other user profiles
      allow update, delete: if isOwner();
      // A user can update their own profile (e.g. display name) but NOT change role
      allow update: if isAuth() && request.auth.uid == uid
                    && request.resource.data.role == resource.data.role;
    }

    // ── pendingInvites — for email-link staff invite flow ────────────────────
    match /pendingInvites/{inviteId} {
      // Allow anyone to read (including newly signed-in users before profile exists)
      allow read: if true;
      // Only owner can create/update/delete invites
      allow write: if isOwner();
    }

    // ── AEPS Withdrawals ─────────────────────────────────────────────────────
    match /aepsWithdrawals/{id} {
      allow read, write: if canAccessFinancial();
    }

    // ── Electric Recharges ────────────────────────────────────────────────────
    match /electricRecharges/{id} {
      allow read, write: if canAccessFinancial();
    }

    // ── Money Transfers ───────────────────────────────────────────────────────
    match /moneyTransfers/{id} {
      allow read, write: if canAccessFinancial();
    }
  }
}
