rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ─────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function userDoc() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function getRole() {
      return exists(userDoc())
        ? get(userDoc()).data.role
        : null;
    }

    function isOwner() {
      return isAuth() && getRole() == 'owner';
    }

    function isStaff() {
      return isAuth() && getRole() == 'staff';
    }

    function isOwnerOrStaff() {
      return isOwner() || isStaff();
    }

    // ── Work Entries — both owner and staff can read and write ───────────────
    match /workEntries/{entryId} {
      allow read, write: if isOwnerOrStaff();
    }

    // ── Categories — both can read; only owner can write ─────────────────────
    match /categories/{catId} {
      allow read: if isOwnerOrStaff();
      allow write: if isOwner();
    }

    // ── Settings (shopSettings, categoriesSeeded, etc.) ──────────────────────
    // Both roles can read shop settings; only owner can write
    match /settings/{settingId} {
      allow read: if isOwnerOrStaff();
      allow write: if isOwner();
    }

    // ── Users collection ─────────────────────────────────────────────────────
    // Any authenticated user can read (needed to fetch own role on login).
    // Owner can create any user document (staff accounts).
    // Any authenticated user can create their own document IF no users exist yet
    // (first-time bootstrap — owner sets themselves up).
    // Only owner can update or delete.
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isOwner()
                    || (isAuth()
                        && request.auth.uid == userId
                        && !exists(/databases/$(database)/documents/users/$(request.auth.uid)));
      allow update, delete: if isOwner();
    }
  }
}
