modules = ["nodejs-20", "web", "bash"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "AZAAN CSC Frontend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "API Server"

[[workflows.workflow]]
name = "AZAAN CSC Frontend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5173 BASE_PATH=/ pnpm --filter @workspace/azaan-csc run dev"
waitForPort = 5173

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "API Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=8080 pnpm --filter @workspace/api-server run dev"
waitForPort = 8080

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
VITE_FIREBASE_APP_ID = "1:260477713078:web:37740e67b5e9119cff0417"
VITE_FIREBASE_AUTH_DOMAIN = "csc-dashboard-b132b.firebaseapp.com"
VITE_FIREBASE_MESSAGING_SENDER_ID = "260477713078"
VITE_FIREBASE_PROJECT_ID = "csc-dashboard-b132b"
VITE_FIREBASE_STORAGE_BUCKET = "csc-dashboard-b132b.firebasestorage.app"
VITE_DEMO_MODE = "false"

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 9005
